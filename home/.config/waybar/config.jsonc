{
    "layer": "top",
    "position": "top",
    "height": 40,
    "width": 1400,
    "padding": 4,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
	"custom/media",
        "clock"
    ],

    "modules-right": [
	"hyprland/language",
        "network",
        "pulseaudio",
        "cpu",
        "memory"
    ],

    "hyprland/workspaces": {
        "format": "{name}"
    },

    "clock": {
        "format": "{:%H:%M}"
    },

"mpris": {
    "format": "󰎆  {artist} — {title}",
    "format-paused": "󰏤  {artist} — {title}",
    "format-stopped": "󰎆  No music",
    "max-length": 45,
    "tooltip": true,
    "tooltip-format": "{artist} — {title}\n{album}",
    "on-click": "playerctl play-pause",
    "on-click-middle": "playerctl next",
    "on-click-right": "playerctl previous"
},

"hyprland/language": {
    "format": "{}",
    "format-en": "EN",
    "format-dk": "DK",
    "format-ru": "RU",
    "format-uk": "UA"
},

"custom/media": {
    "exec": "~/.config/waybar/media.sh",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "playerctl play-pause",
    "on-click-middle": "playerctl next",
    "on-click-right": "playerctl previous"
},

    "network": {
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟"
    },

    "cpu": {
        "format": "CPU {usage}%"
    },

    "memory": {
        "format": "RAM {percentage}%"
    }
}
